{
  "name": "webblox",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "onCreateCommand": "npm install -g bun && bun install",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "webblox", "onAutoForward": "notify" }
  },
  "hostRequirements": { "storage": "32gb" }
}
